{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hlb/carousel-slide",
  "version": "0.3.0",
  "title": "Slide",
  "category": "design",
  "icon": "format-image",
  "description": "One slide in a carousel. Holds any blocks.",
  "parent": [
    "hlb/carousel"
  ],
  "textdomain": "hlb-carousel",
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "link": true
    },
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "minHeight": true
    },
    "spacing": {
      "padding": true,
      "blockGap": true
    },
    "layout": {
      "allowSizingOnChildren": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}